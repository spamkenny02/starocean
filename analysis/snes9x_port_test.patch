index 6060767..9f61cd0 100644
--- a/libretro/libretro.cpp
+++ b/libretro/libretro.cpp
@@ -2169,3 +2169,6 @@ void S9xAutoSaveSRAM()
 {
     return;
 }
+extern "C" unsigned int retro_so_debug_pc(void) { return Registers.PBPC; }
+extern "C" unsigned int retro_so_debug_sdd1(void) { return Settings.SDD1; }
+extern "C" unsigned int retro_so_debug_joy(void) { return Memory.FillRAM[0x4218] | (Memory.FillRAM[0x4219] << 8); }
